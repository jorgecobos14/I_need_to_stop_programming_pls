<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d1117"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#e6edf3"
            android:gravity="center"
            android:background="#1c2128"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACHO · COMUNIDAD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8b949e"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 NUEVO"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#e6edf3"
            android:background="#1c2128"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#161b22"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/avatar1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="--"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#e6edf3"
            android:gravity="center"
            android:background="#2d3340"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/author1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#e6edf3"
                android:maxLines="1"
            android:ellipsize="end"/>

            <TextView
                android:id="@+id/text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#8b949e"
                android:maxLines="1"
            android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="#3d444d"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#161b22"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/avatar2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="--"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#e6edf3"
            android:gravity="center"
            android:background="#2d3340"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/author2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#e6edf3"
                android:maxLines="1"
            android:ellipsize="end"/>

            <TextView
                android:id="@+id/text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#8b949e"
                android:maxLines="1"
            android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="#3d444d"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#161b22"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/avatar3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="--"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#e6edf3"
            android:gravity="center"
            android:background="#2d3340"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/author3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#e6edf3"
                android:maxLines="1"
            android:ellipsize="end"/>

            <TextView
                android:id="@+id/text3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#8b949e"
                android:maxLines="1"
            android:ellipsize="end"/>
        </LinearLayout>

        <TextView
            android:id="@+id/time3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="#3d444d"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

</LinearLayout>

